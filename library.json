{
  "name": "ESP32WebDash",
  "version": "0.1.1",
  "description": "Schema-driven web UI for ESP32: settings in NVS with JSON import/export, live values over WebSocket, actions, OTA, setup hotspot, login and log console. UI assets on LittleFS.",
  "keywords": "esp32, web, ui, settings, nvs, littlefs, websocket, ota, captive portal",
  "authors": [{ "name": "Christian Egger", "maintainer": true }],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": "ESP32WebDash.h",
  "dependencies": [
    { "owner": "esp32async", "name": "ESPAsyncWebServer", "version": "^3.7.0" },
    { "owner": "esp32async", "name": "AsyncTCP", "version": "^3.4.0" },
    { "owner": "bblanchon", "name": "ArduinoJson", "version": "^7.4.0" }
  ],
  "build": {
    "srcDir": "src",
    "extraScript": "scripts/build_web.py"
  },
  "export": {
    "exclude": [".github", "*.DS_Store"]
  },
  "examples": [
    { "name": "Greenhouse", "base": "examples/Greenhouse", "files": ["platformio.ini", "src/main.cpp"] }
  ]
}
